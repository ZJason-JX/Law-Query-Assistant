# 首次启动服务时，本文件会被自动复制为 .env（占位值）。
# 把下面的 apikey_123123 换成你自己的密钥即可；.env 已被 gitignore，永远不会提交。
# 也可以启动后在「管理后台 → 设置 → API 密钥」里粘贴，效果相同（写回本机 .env）。

# 火山方舟 · 生成主链（S3 门控 / S4 生成 / 拒答）
DOUBAO_API_KEY=apikey_123123
# 方舟接入点 ID（ep- 开头）或模型名；对应管理后台「生成模型」
DOUBAO_MODEL=ep-0000000000000

# JEV / typesafe · S0 意图分类
TYPESAFE_API_KEY=apikey_123123

# DeepSeek · S3 查询扩展
DEEPSEEK_API_KEY=apikey_123123

# 通义千问 · judge 评审（评测跑批与实时评分用；不评测可不填）
QWEN_API_KEY=apikey_123123
